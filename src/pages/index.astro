---
import BaseLayout from '../layouts/BaseLayout.astro'; import ResearchCard from '../components/ResearchCard.astro'; import ResearchMap from '../components/ResearchMap.astro'; import ConferencePhoto from '../components/ConferencePhoto.astro'; import {getCollection} from 'astro:content'; import {profile} from '../data/profile'; const projects=(await getCollection('research')).sort((a,b)=>a.data.order-b.data.order);
---
<BaseLayout title="Hongliang Sun | Housing Policy & Urban Governance" switchHref="/zh/"><section class="wrap hero"><div><div class="eyebrow">PhD Candidate · Public Administration</div><h1>Hongliang Sun<span>孙红亮</span></h1><p>{profile.role}<br/>{profile.school}</p><p class="lead">Housing is never only shelter. It is land, memory, wealth, belonging—and a quiet architecture of political life.</p><div class="actions"><a class="button primary" href="/research/">Explore Research</a><a class="button" href="/cv/">View CV</a><a class="button" href={`mailto:${profile.email}`}>Contact</a></div></div><ConferencePhoto/></section><section class="section constellation-section"><div class="wrap constellation-grid"><div><span class="kicker">Research constellation</span><h2>Housing, urban, and public economics</h2></div><ResearchMap/></div></section><section class="section"><div class="wrap"><div class="section-head"><span class="kicker">01 / Research</span><div><h2>Selected research</h2><p class="muted">Housing policy, urban governance, and the political life of cities.</p></div></div><div class="cards">{projects.map((p,i)=><ResearchCard entry={p} index={i+1}/>)}</div></div></section><section class="section"><div class="narrow"><span class="kicker">02 / Research statement</span><h2>Institutions are written into urban space.</h2><p class="lead">My research asks how housing systems reshape inequality, local governance, and political participation. I am particularly interested in how large-scale public interventions alter not only where people live, but also how they relate to communities and public institutions.</p></div></section><section class="section"><div class="wrap section-head"><span class="kicker">03 / Field Notes</span><div><h2>An open notebook</h2><p>Future notes on lectures, field observations, reading, city walks, conferences, and research in progress.</p><a href="/notes/">About this notebook →</a></div></div></section></BaseLayout>
