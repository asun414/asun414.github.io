---
import ContentLayout from '../../../layouts/ContentLayout.astro';
---
<ContentLayout title="Private notes" description="A private working archive that is not published on this website.">
  <p><a href="/notes/">← All notes</a></p>
  <article class="pub">
    <div class="kicker">Private archive</div>
    <h2>Kept off the public web</h2>
    <p>This space represents a private collection of working notes. No private entries, files, or personal data are included in the website build.</p>
    <p class="muted">Private notes are stored separately and protected by Cloudflare Access. They are never included in the public GitHub Pages build.</p>
    <a class="button" href="https://notes.hlsun.org/" rel="noreferrer">Open private workspace →</a>
  </article>
</ContentLayout>
