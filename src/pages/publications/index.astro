---
import ContentLayout from '../../layouts/ContentLayout.astro'; import {getCollection} from 'astro:content'; const all=(await getCollection('publications')).sort((a,b)=>b.data.year-a.data.year||a.data.order-b.data.order); const pubs=all.filter(x=>x.data.category==='publication'); const wp=all.filter(x=>x.data.category==='working-paper');
---
<ContentLayout title="Publications" description="Verified publications and current working papers."><h2>Publications</h2>{pubs.map(x=><article class="pub"><div class="meta">{x.data.authors} ({x.data.year})</div><div class="pub-title">{x.data.title}</div><div>{x.data.venue}</div>{x.data.doi&&<a href={x.data.doi} target="_blank" rel="noreferrer">DOI <span aria-hidden="true">↗</span></a>}</article>)}<h2>Working Papers</h2>{wp.map(x=><article class="pub"><div class="meta">{x.data.authors} ({x.data.year})</div><div class="pub-title">{x.data.title}</div><div>{x.data.venue}</div><p class="meta">Draft available upon request.</p></article>)}<h2>Work in Progress</h2><p class="muted">See the <a href="/research/">Research page</a> for current projects.</p><h2>Book Chapters</h2><p class="muted">No verified entries yet.</p><h2>Other Writing</h2><p class="muted">Verified public-facing writing will be added here.</p></ContentLayout>
