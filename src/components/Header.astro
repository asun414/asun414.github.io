---
import ThemeToggle from './ThemeToggle.astro'; import LanguageSwitch from './LanguageSwitch.astro';
import { enNav, zhNav } from '../data/navigation'; import { profile } from '../data/profile';
const {lang='en', switchHref}=Astro.props; const nav=lang==='zh'?zhNav:enNav;
---
<header><div class="wrap nav"><a class="brand" href={lang==='zh'?'/':'/en/'}>{profile.shortName}</a><button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-navigation" data-menu>菜单</button><nav id="site-navigation" class="navlinks" aria-label={lang==='zh'?'主导航':'Primary navigation'}>{nav.map(([label,url])=><a href={url} aria-current={Astro.url.pathname===url?'page':undefined}>{label}</a>)}<div class="navtools"><LanguageSwitch lang={lang} href={switchHref}/><ThemeToggle /></div></nav></div></header>
