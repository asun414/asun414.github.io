{
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "terminal.integrated.cwd": "${workspaceFolder}",
  "files.encoding": "utf8",
  "files.eol": "\n",
  "editor.formatOnSave": false,
  "files.exclude": {
    "**/.astro": true,
    "**/dist": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/_backup": true
  }
}
